{
  "name": "@galacean/engine",
  "version": "2.0.0-alpha.47",
  "description": "Galacean is a web-first, mobile-first, high-performance real-time interactive engine with component-based design, supporting 2D/3D graphics, animation, physics, input and TypeScript scripting.",
  "keywords": [
    "galacean",
    "game-engine",
    "webgl",
    "3d",
    "2d",
    "typescript",
    "real-time",
    "graphics",
    "animation",
    "physics"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "license": "MIT",
  "scripts": {
    "b:types": "tsc && pnpm run validate:engine-knowledge",
    "validate:engine-knowledge": "node scripts/validate-engine-knowledge.mjs"
  },
  "types": "types/index.d.ts",
  "main": "dist/main.js",
  "module": "dist/module.js",
  "unpkg": "dist/bundled.module.min.js",
  "jsdelivr": "dist/bundled.module.min.js",
  "files": [
    "dist/**/*",
    "types/**/*",
    "skills/**/*"
  ],
  "umd": {
    "name": "Galacean"
  },
  "homepage": "https://galacean.antgroup.com/",
  "repository": {
    "url": "https://github.com/galacean/engine"
  },
  "dependencies": {
    "@galacean/engine-core": "workspace:*",
    "@galacean/engine-loader": "workspace:*",
    "@galacean/engine-math": "workspace:*",
    "@galacean/engine-rhi-webgl": "workspace:*",
    "@galacean/engine-shader": "workspace:*"
  }
}
