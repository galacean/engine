{
  "name": "@galacean/engine-retrieval",
  "version": "2.0.0-alpha.52",
  "private": true,
  "description": "Shared asset retrieval capabilities used by World demos.",
  "type": "module",
  "sideEffects": true,
  "main": "./src/index.ts",
  "module": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./*": "./src/*",
    "./index": "./src/index.ts",
    "./retrieval": "./src/retrieval/index.ts",
    "./retrieval/index": "./src/retrieval/index.ts",
    "./retrieval/src/contracts": "./src/retrieval/src/contracts.ts",
    "./retrieval/src/storage": "./src/retrieval/src/storage.ts"
  },
  "scripts": {
    "retrieval:examples": "tsx src/retrieval/scripts/build-examples.ts",
    "test:retrieval": "tsx --test src/retrieval/tests/*.test.ts",
    "typecheck:retrieval": "tsc -p src/retrieval/tsconfig.json"
  },
  "dependencies": {
    "zod": "4.4.3"
  },
  "devDependencies": {
    "tsx": "4.20.6",
    "typescript": "5.6.3"
  }
}
