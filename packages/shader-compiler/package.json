{
  "name": "@galacean/engine-shader-compiler",
  "version": "2.0.0-alpha.42",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "repository": {
    "url": "https://github.com/galacean/engine.git"
  },
  "license": "MIT",
  "main": "dist/main.js",
  "module": "dist/module.js",
  "unpkg": "dist/browser.min.js",
  "jsdelivr": "dist/browser.min.js",
  "debug": "src/index.ts",
  "types": "types/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/module.js",
      "require": "./dist/main.js",
      "types": "./types/index.d.ts"
    },
    "./offline": {
      "import": "./dist/offline.module.js",
      "require": "./dist/offline.main.js",
      "types": "./types/offline.d.ts"
    },
    "./bundler/rollup": {
      "import": "./bundler/rollup.js",
      "require": "./bundler/rollup.cjs.js",
      "types": "./types/bundler/rollup.d.ts"
    },
    "./bundler/precompile": {
      "import": "./bundler/precompile.js",
      "require": "./bundler/precompile.cjs.js",
      "types": "./types/bundler/precompile.d.ts"
    },
    "./src/*": "./src/*.ts",
    "./package.json": "./package.json"
  },
  "bin": {
    "shader-compiler-precompile": "./bundler/cli.js"
  },
  "scripts": {
    "build": "rollup -c rollup.config.js",
    "b:types": "tsc"
  },
  "umd": {
    "name": "Galacean.ShaderCompiler",
    "globals": {
      "@galacean/engine-math": "Galacean",
      "@galacean/engine-core": "Galacean"
    }
  },
  "files": [
    "dist/**/*",
    "bundler/**/*",
    "types/**/*"
  ],
  "dependencies": {
    "@rollup/pluginutils": "^5.0.0",
    "@galacean/engine-math": "workspace:*",
    "@galacean/engine-core": "workspace:*",
    "@galacean/engine-design": "workspace:*",
    "@galacean/engine-shader-parser": "workspace:*"
  }
}
