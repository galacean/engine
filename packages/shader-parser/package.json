{
  "name": "@galacean/engine-shader-parser",
  "version": "2.0.0-alpha.33",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "repository": {
    "url": "https://github.com/galacean/engine.git"
  },
  "license": "MIT",
  "exports": {
    "./internal": {
      "types": "./types/runtime.d.ts",
      "debug": "./src/runtime.ts",
      "import": "./dist/module.js",
      "require": "./dist/main.js"
    },
    "./internal/verbose": {
      "types": "./types/index.d.ts",
      "debug": "./src/index.ts",
      "import": "./dist/module.verbose.js",
      "require": "./dist/main.verbose.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "b:types": "tsc"
  },
  "files": [
    "dist/**/*",
    "types/**/*",
    "internal/package.json",
    "internal/verbose/package.json"
  ],
  "dependencies": {
    "@galacean/engine-core": "workspace:*",
    "@galacean/engine-math": "workspace:*"
  },
  "devDependencies": {
    "@galacean/engine-design": "workspace:*"
  }
}
