{
  "name": "@galacean/engine-webgl1-polyfill",
  "version": "2.0.0-alpha.57",
  "repository": {
    "url": "https://github.com/galacean/engine.git"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "license": "MIT",
  "main": "dist/main.js",
  "module": "dist/npm.module.js",
  "debug": "src/index.ts",
  "scripts": {
    "b:types": "tsc"
  },
  "types": "types/index.d.ts",
  "files": [
    "dist/**/*",
    "types/**/*"
  ],
  "dependencies": {},
  "devDependencies": {
    "@galacean/engine-core": "workspace:*",
    "@galacean/engine-rhi-webgl": "workspace:*",
    "@galacean/engine-math": "workspace:*"
  },
  "exports": {
    ".": {
      "types": "./types/index.d.ts",
      "import": "./dist/npm.module.js",
      "require": "./dist/main.js"
    }
  },
  "peerDependencies": {
    "@galacean/engine-core": "workspace:*",
    "@galacean/engine-math": "workspace:*",
    "@galacean/engine-rhi-webgl": "workspace:*"
  },
  "rollup": {
    "output": [
      {
        "file": "dist/module.js",
        "format": "iife",
        "name": "polyfill",
        "sourcemap": true,
        "globals": {
          "@galacean/engine-core": "bindings",
          "@galacean/engine-math": "bindings",
          "@galacean/engine-rhi-webgl": "bindings"
        },
        "banner": "const registry = { devices: new WeakMap(), installedMembers: new WeakMap() };\nexport function bind(bindings) {",
        "footer": "return polyfill.bind(bindings, registry);\n}"
      }
    ]
  }
}
