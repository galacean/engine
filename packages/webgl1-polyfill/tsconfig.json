{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "module": "esnext",
    "target": "esnext",
    "declaration": true,
    "moduleResolution": "node",
    "paths": {
      "@/override": ["./src/override.ts"]
    },
    "allowSyntheticDefaultImports": true,
    "experimentalDecorators": true,
    "declarationDir": "types",
    "emitDeclarationOnly": true,
    "noImplicitAny": true,
    "noImplicitOverride": true,
    "sourceMap": true,
    "incremental": false,
    "skipLibCheck": true,
    "allowJs": true,
    "checkJs": false
  },
  "include": [
    "src/**/*"
  ]
}
