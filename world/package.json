    "@galacean/engine-math": "workspace:*",
    "@galacean/engine-physics-physx": "workspace:*",
    "@galacean/engine-shader": "workspace:*",
    "@galacean/engine-shader-compiler": "workspace:*",
    "@galacean/engine-ui": "workspace:*",
    "@galacean/engine-toolkit-controls": "latest",
    "@galacean/engine-toolkit-stats": "latest",
    "esbuild-wasm": "0.25.8",
    "zod": "4.4.3",
    "acorn": "8.17.0",
    "re2js": "2.9.0",
    "mdast-util-from-markdown": "2.0.3",
    "mdast-util-gfm": "3.1.0",
    "mdast-util-math": "3.0.0",
    "micromark-extension-gfm": "3.0.0",
    "micromark-extension-math": "3.1.0",
    "micromark-util-character": "2.1.1",
    "micromark-util-classify-character": "2.0.1",
    "micromark-util-symbol": "2.0.1",
    "micromark-util-types": "2.0.2",
    "micromark-factory-space": "2.0.1",
    "micromark-core-commonmark": "2.0.3",
    "shiki": "4.4.3",
    "@shikijs/langs": "4.4.3",
    "katex": "0.18.7",
    "diff": "9.0.0",
    "@tanstack/react-virtual": "3.14.10",
    "clsx": "2.1.1",
    "micromark-util-sanitize-uri": "2.0.1",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "simple-icons": "16.31.0",
    "@galacean/engine-terrain": "workspace:*",
    "@galacean/engine-water": "workspace:*",
    "@galacean/engine-animals": "workspace:*",
    "@galacean/engine-building": "workspace:*",
    "@galacean/engine-farming": "workspace:*",
    "@galacean/engine-vegetation": "workspace:*",
    "@galacean/engine-environment": "workspace:*",
    "@galacean/engine-ai-chat": "workspace:*",
    "@galacean/engine-project": "workspace:*",
    "@galacean/engine-runtime-editor": "workspace:*",
    "@galacean/engine-world-planning": "workspace:*",
    "@galacean/engine-modify": "workspace:*",
    "@galacean/engine-retrieval": "workspace:*"
  },
  "devDependencies": {
    "typescript": "5.6.3",
    "@types/dat.gui": "^0.7.13",
    "dat.gui": "^0.7.9",
    "ktx-parse": "1.1.0",
    "vite": "^4.4.4",
    "@types/mdast": "4.0.4",
